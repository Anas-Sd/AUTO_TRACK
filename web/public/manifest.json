      "url": "/?tab=overview",
      "icons": [{ "src": "/icons/shortcut-overview.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Categories",
      "short_name": "Categories",
      "description": "Manage your expense categories",
      "url": "/?tab=categories",
      "icons": [{ "src": "/icons/shortcut-categories.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ]
